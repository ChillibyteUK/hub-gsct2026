{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "hub-gsct2026/hub-form",
	"title": "HUB Form",
	"category": "hub-gsct2026",
	"icon": "feedback",
	"description": "Standalone form shortcode, same shaded/padded/rounded container as HUB Content Block's Form media type.",
	"attributes": {
		"formTitle": {
			"type": "string",
			"default": ""
		},
		"formShortcode": {
			"type": "string",
			"default": ""
		}
	},
	"supports": {
		"anchor": true,
		"className": true,
		"align": true,
		"color": {
			"background": true
		}
	},
	"editorScript": "file:./build/index.js",
	"render": "file:./render.php"
}
