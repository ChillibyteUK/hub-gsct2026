{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "hub-gsct2026/hub-document-library-hero",
	"title": "HUB Document Library Hero",
	"category": "hub-gsct2026",
	"icon": "media-document",
	"description": "Sunset-gradient hero with title, intro and three downloadable document cards (title, file, manual UK date — type and size derived from the file).",
	"attributes": {
		"title": {
			"type": "string",
			"default": ""
		},
		"intro": {
			"type": "string",
			"default": ""
		},
		"cardsTitle": {
			"type": "string",
			"default": "Latest investor documents"
		},
		"cards": {
			"type": "array",
			"default": []
		}
	},
	"supports": {
		"anchor": true,
		"className": true,
		"align": true
	},
	"editorScript": "file:./build/index.js",
	"render": "file:./render.php"
}
